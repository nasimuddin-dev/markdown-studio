{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["scripts/*.mjs", "e2e/**/*.ts", "e2e-native/**/*.test.mjs", "tests/**/*.{ts,tsx}"],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs", "tests/**/*.{ts,tsx}", "e2e/**/*.ts", "e2e-native/**/*.mjs"],
  "ignoreExportsUsedInFile": true,
  "rules": { "types": "off" }
}
