{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    // The pages (../docs/site) sit outside this folder; resolve their imports here.
    "paths": {
      "typescript": ["./node_modules/typescript"],
      "vitepress": ["./node_modules/vitepress"]
    }
  },
  "include": [".vitepress/config.ts", "../docs/site/data/*.ts"]
}
